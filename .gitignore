# Dependencies.
/node_modules/
/vendor/

# Local WordPress test installations.
/.wp-core/
/.wp-tests/

# Build and test output.
/build/
/dist/
/coverage/
/.phpunit.cache/
/.phpunit.result.cache
/check.txt
/phpmd.txt
/plugin-error.log
/clover.xml
/junit.xml

# Release archives are generated by `npm run dist`.
/*.zip
/*.tar.gz
/*.rar

# Local environment and credentials.
/.env
/.env.*
!/.env.example
/auth.json
/wp-config.php

# Logs and temporary files.
*.log
*.bak
*.swp
*.swo
*.tmp
*~

# Generated source maps and compiled intermediates.
*.compiled
*.css.map
*.js.map

# OS and editor metadata.
.DS_Store
Thumbs.db
/.idea/
/.vscode/
*.sublime-project
*.sublime-workspace

# Local automation workspaces and run metadata.
/.cstn-generator/
/.codex/
/.codex-backups/
/codex-yolo
/.codex_index.json
/.codex_run_meta.json
/.codex_tasks.csv
/.codex_test_output.log
