# Ignore common directories and files in WordPress plugin development

# Node modules
node_modules/

# Dependency directories
vendor/
.wp-core/
.wp-tests/

# OS generated files
.DS_Store
Thumbs.db

# Editor settings
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Log files
*.log

# Compiled asset files
*.compiled
*.css.map
*.js.map

# Packaging
*.zip
*.tar.gz
*.rar

# Temporary files
*.bak
*.swp
*.tmp

# Including the wp-config.php file if accidentally placed in the plugin directory
wp-config.php

# Ignore specific plugin or theme related files that are auto-generated
# e.g., if your plugin generates any specific cache or debug files, exclude them here

# Example for ignoring a custom cache directory (replace 'custom_cache/' with your actual directory)
# custom_cache/
.cstn-generator/
.codex
.codex/
.codex-backups/
codex-yolo
codex-yolo/
check.txt
phpmd.txt
plugin-error.log
.phpunit.result.cache
.phpunit.cache/
coverage/
.codex_index.json
.codex_run_meta.json
.codex_tasks.csv
.codex_test_output.log
AGENTS.md
SPEC.md
MEMORY.md
PLAN.md
PLAYBOOK.md
DESIGN_SYSTEM.md
UI_AUDIT.md
APP_FLOW.md
FRONTEND_GUIDELINES.md
DESIGN_LESSONS.md
